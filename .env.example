# Single shared password that unlocks every password-protected case study.
# To gate a future project: just add `protected: true` to its MDX frontmatter —
# it uses this same password, no per-project env var needed.
PASSWORD_PROJECTS=

# Production URL, used to resolve absolute OG/metadata image URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics (GA4) measurement ID. Leave unset to disable GA.
NEXT_PUBLIC_GA_ID=

# Hotjar site ID and tracking script version. Leave either unset to disable Hotjar.
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_HOTJAR_SV=

# GA/Hotjar only ever load on the production Vercel deployment
# (VERCEL_ENV === "production", set automatically by Vercel) — preview
# deployments and local dev never track, so testing a change never
# pollutes real visitor data.
#
# Secret used to additionally exclude your own browser on production:
# visiting https://your-domain.com/?notrack=<this value> sets a 1-year
# cookie that skips loading GA/Hotjar for that browser from then on, and
# redirects to the same URL with the key stripped. Optional — leave unset
# to disable the opt-out link. Use a long random value in your deploy
# environment.
ANALYTICS_OPT_OUT_KEY=

# Site-wide maintenance mode (see middleware.ts).
# Set to the literal string "true" to show the maintenance page to every
# visitor except those with the bypass cookie. Off/unset = site behaves
# exactly as normal, no exceptions.
MAINTENANCE_MODE=false

# Secret used for the maintenance bypass link: visiting
# https://your-domain.com/?key=<this value> sets a 1-year httpOnly cookie
# that lets that browser skip maintenance mode from then on, and redirects
# to the same URL with the key stripped. Required only when
# MAINTENANCE_MODE=true. Use a long random value in your deploy environment.
MAINTENANCE_BYPASS_KEY=
