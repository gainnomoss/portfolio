# Password for the gated case study at /work/ai-assisted-police-report-lodging
# Env var name is derived from the project slug — see lib/auth.ts envVarForSlug().
# To gate a future project: add `protected: true` to its MDX frontmatter, then
# add PASSWORD_<SLUG-IN-SCREAMING-SNAKE-CASE> here (and in your deploy environment).
PASSWORD_AI_ASSISTED_POLICE_REPORT_LODGING=

# Production URL, used to resolve absolute OG/metadata image URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Site-wide maintenance mode (see middleware.ts).
# Set to the literal string "true" to show the maintenance page to every
# visitor except those with the bypass cookie. Off/unset = site behaves
# exactly as normal, no exceptions.
MAINTENANCE_MODE=false

# Secret used for the maintenance bypass link: visiting
# https://your-domain.com/?key=<this value> sets a 1-year httpOnly cookie
# that lets that browser skip maintenance mode from then on, and redirects
# to the same URL with the key stripped. Required only when
# MAINTENANCE_MODE=true. Use a long random value in your deploy environment.
MAINTENANCE_BYPASS_KEY=
