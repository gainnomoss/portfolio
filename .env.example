# Password for the gated case study at /work/ai-assisted-police-report-lodging
# Env var name is derived from the project slug — see lib/auth.ts envVarForSlug().
# To gate a future project: add `protected: true` to its MDX frontmatter, then
# add PASSWORD_<SLUG-IN-SCREAMING-SNAKE-CASE> here (and in your deploy environment).
PASSWORD_AI_ASSISTED_POLICE_REPORT_LODGING=

# Production URL, used to resolve absolute OG/metadata image URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
